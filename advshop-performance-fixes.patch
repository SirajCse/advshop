+                ->timeout(15)
+                ->connectTimeout(5)
+                ->withoutVerifying()
+                ->get($url);
+        } catch (Exception) {
+            $this->markAsFailed($url);
+
+            return null;
+        }
 
         if ($response->failed()) {
+            $this->markAsFailed($url);
+
             return null;
         }
 
